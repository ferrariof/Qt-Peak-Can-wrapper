	cd src\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Libs\CanDLL\R4\src\src.pro -spec win32-g++ "CONFIG+=debug" "CONFIG-=qml_debug" ) && $(MAKE) -f Makefile debug
