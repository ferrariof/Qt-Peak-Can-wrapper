sub-TestDLL-TestDLL-debug_ordered:
	@if not exist TestDLL\TestDLL\ mkdir TestDLL\TestDLL\ & if not exist TestDLL\TestDLL\ exit 1
	cd TestDLL\TestDLL\ && ( if not exist Makefile $(QMAKE) -o Makefile D:\Libs\CanDLL\R4\TestDLL\TestDLL\TestDLL.pro -spec win32-g++ "CONFIG+=debug" "CONFIG-=qml_debug" ) && $(MAKE) -f Makefile debug
